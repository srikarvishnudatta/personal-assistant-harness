HARNESS_TOKEN=replace-with-a-long-random-secret
OPENAI_API_KEY=replace-with-your-openai-key
OPENAI_MODEL=gpt-6-luna

# Local runtime (never deploy this file)
LOCAL_PORT=8787
# Optional static UI adapter; disable when using the Vite development server.
SERVE_FRONTEND=true
FRONTEND_DIST_DIR=frontend/dist
DAILY_TOKEN_LIMIT=200000
RUN_TOKEN_RESERVATION=100000
# Set these only after creating a Google OAuth web client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Additional providers: configure origins/client IDs here; authorize tokens in Connections.
SPOTIFY_CLIENT_ID=
MASTODON_BASE_URL=
SHOPIFY_STORE=
# Explicit trusted installation origin, e.g. http://192.168.1.10:8123 (read-only states).
HOME_ASSISTANT_BASE_URL=
# Optional dedicated browser executable/channel; default Windows channel is msedge.
BROWSER_EXECUTABLE_PATH=
BROWSER_CHANNEL=
# No host shell or VM. Isolated script execution is optional and disabled.
ENABLE_DOCKER_EXECUTION=false
DOCKER_IMAGE=python:3.12-slim
